        //named//
    }
    //positional//
    return r;
}
/*@ %

First, [[kwd_fn]] is called on each argument with a [[name]] (that isn't
``[[...]]'').

==named*/
for(int i = 0; r && i < nargs; i++)
{
    void *arg = args[i];
    rsymbol_t *name = names[i];

    if(name && name != r_sym_rest)
        r &= kwd_fn(ptr, name, arg);
}
/*@

Then each remaining argument, in the order given, is passed to one of
the other callbacks: ``[[...]]'' to [[rest_fn]], [[NULL]] to
[[omit_fn]], otherwise [[pos_fn]].

==positional*/
for(int i = 0; r && i < nargs; i++)
{
    void *arg = args[i];

    if(names && names[i] == r_sym_rest)
        r &= rest_fn(ptr, arg);
    else if(names && names[i])
        continue;
    else if(arg)
        r &= pos_fn(ptr, arg);
    else
        r &= omit_fn(ptr);
}
