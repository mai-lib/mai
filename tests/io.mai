# binary vector I/O: write_vec returns the element count, read_vec reads back
x = vec(1.5, NA, -2.25, 1e-300)
print(write_vec(x, "io-tmp-d.bin"))
y = read_vec("io-tmp-d.bin", type(double))
print(is_na(y))
print(y[4] * 1e300)
print(equal(y[1], 1.5))
print(write_vec(1:5, "io-tmp-i.bin"))
print(read_vec("io-tmp-i.bin", type(int)))
print(write_vec(vec(true, false), "io-tmp-b.bin"))
print(read_vec("io-tmp-b.bin", type(boolean)))
m = array(type(double), vec(2, 2), 0.5)
print(write_vec(m, "io-tmp-m.bin"))
print(sum(read_vec("io-tmp-m.bin", type(double))))
read_vec("io-tmp-i.bin", type(double))
