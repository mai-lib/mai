# Types. Declarations are optional, but they let the compiler generate
# specialised code, and they are checked.

print(typeof(1))        # int
print(typeof(1.0))      # double
print(typeof(1:3))      # vector(int)
print(typeof(true))     # boolean
print(typeof('sym'))    # symbol

# Integer arithmetic stays integer: this is the biggest surprise for R users.
print(7 / 2)            # 3, not 3.5
print(7 / 2.0)          # 3.5
print(2 ^ 31)           # NA: the int result overflows
print(2.0 ^ 31)

# Typed formals and return types.
const hyp = function(double a, double b) : double sqrt(a * a + b * b)
print(hyp(3.0, 4.0))

# Explicit conversion.
print(as_double(1:3))
print(as_int(3.9))
print(as_type(1:3, type(double)))

# const globals cannot be reassigned; var and let declare locals.
const limit = 10
f = function() {
    var total = 0
    for(int i = 1; i <= limit; i = i + 1)
        total = total + i
    total
}
print(f())

# Missing values.
m = vec(1.0, NA, 3.0)
print(m)
print(is_na(m))
print(sum(m))
